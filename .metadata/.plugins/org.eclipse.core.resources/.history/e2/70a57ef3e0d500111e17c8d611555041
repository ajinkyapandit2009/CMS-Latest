package com.cmsbackend.services.impl;

import java.awt.image.BufferedImage;
import java.io.IOException;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.time.LocalDateTime;
import java.util.Set;
import java.util.UUID;
import javax.imageio.ImageIO;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.server.ResponseStatusException;
import com.cmsbackend.dtos.ComplaintPhotoUploadResponseDto;
import com.cmsbackend.entities.Complaint;
import com.cmsbackend.entities.ComplaintPhotoUpload;
import com.cmsbackend.entities.User;
import com.cmsbackend.enums.Role;
import com.cmsbackend.repositories.ComplaintPhotoUploadRepository;
import com.cmsbackend.repositories.UserRepository;
import com.cmsbackend.services.ComplaintPhotoService;

@Service
public class ComplaintPhotoServiceImpl implements ComplaintPhotoService {
    private final ComplaintPhotoUploadRepository uploadRepository;
    private final UserRepository userRepository;
    private final Path storageRoot;
    private final long maxBytes;
    private final BigDecimal maxAccuracy;
    public ComplaintPhotoServiceImpl(ComplaintPhotoUploadRepository uploadRepository, UserRepository userRepository, @Value("${cms.photo.storage-dir:uploads/complaints}") String storageDir, @Value("${cms.photo.max-size-bytes:5242880}") long maxBytes, @Value("${cms.photo.max-accuracy-meters:50}") BigDecimal maxAccuracy) { this.uploadRepository = uploadRepository; this.userRepository = userRepository; this.storageRoot = Path.of(storageDir).toAbsolutePath().normalize(); this.maxBytes = maxBytes; this.maxAccuracy = maxAccuracy; }
    @Override @Transactional public ComplaintPhotoUploadResponseDto upload(MultipartFile photo, BigDecimal latitude, BigDecimal longitude, BigDecimal accuracy, String email) {
        User user = citizen(email); validateLocation(latitude, longitude, accuracy); if (photo == null || photo.isEmpty()) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "A photo is required"); if (photo.getSize() > maxBytes) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Photo exceeds the maximum size");
        String mime = imageMimeType(photo); UUID uploadId = UUID.randomUUID(); String storageKey = uploadId + extensionFor(mime); Path target = storageRoot.resolve(storageKey).normalize(); if (!target.startsWith(storageRoot)) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid storage path");
        try { Files.createDirectories(storageRoot); Files.copy(photo.getInputStream(), target, StandardCopyOption.REPLACE_EXISTING); } catch (IOException exception) { throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Unable to save the photo"); }
        ComplaintPhotoUpload upload = new ComplaintPhotoUpload(); upload.setUploadId(uploadId); upload.setUser(user); upload.setStorageKey(storageKey); upload.setMimeType(mime); upload.setFileSize(photo.getSize()); upload.setLatitude(latitude); upload.setLongitude(longitude); upload.setAccuracyMeters(accuracy); upload.setExpiresAt(LocalDateTime.now().plusDays(1)); uploadRepository.save(upload);
        ComplaintPhotoUploadResponseDto response = new ComplaintPhotoUploadResponseDto(); response.setUploadId(uploadId); response.setImageUrl(reference(uploadId)); response.setLatitude(latitude); response.setLongitude(longitude); response.setAccuracy(accuracy); return response;
    }
    @Override @Transactional(readOnly = true) public Path getContentPath(UUID uploadId, String email) { ComplaintPhotoUpload upload = uploadRepository.findById(uploadId).orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Photo not found")); authorizeView(upload, currentUser(email)); Path path = storageRoot.resolve(upload.getStorageKey()).normalize(); if (!path.startsWith(storageRoot) || !Files.isRegularFile(path)) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Photo content not found"); return path; }
    @Override @Transactional(readOnly = true) public String getContentType(UUID uploadId, String email) { ComplaintPhotoUpload upload = uploadRepository.findById(uploadId).orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Photo not found")); authorizeView(upload, currentUser(email)); return upload.getMimeType(); }
    @Override @Transactional public void consumeForComplaint(String imageReference, Complaint complaint, BigDecimal latitude, BigDecimal longitude, String email) { UUID uploadId = idFromReference(imageReference); User user = citizen(email); ComplaintPhotoUpload upload = uploadRepository.findByUploadIdAndUser_UserId(uploadId, user.getUserId()).orElseThrow(() -> new ResponseStatusException(HttpStatus.BAD_REQUEST, "The complaint photo does not belong to you")); if (upload.getComplaint() != null || upload.getConsumedAt() != null) throw new ResponseStatusException(HttpStatus.CONFLICT, "This complaint photo has already been used"); if (upload.getExpiresAt() != null && upload.getExpiresAt().isBefore(LocalDateTime.now())) throw new ResponseStatusException(HttpStatus.CONFLICT, "This complaint photo has expired"); if (latitude == null || longitude == null || upload.getLatitude().compareTo(latitude) != 0 || upload.getLongitude().compareTo(longitude) != 0) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Complaint location must match the uploaded photo location"); upload.setComplaint(complaint); upload.setConsumedAt(LocalDateTime.now()); }
    private User citizen(String email) { User user = currentUser(email); if (user.getUserRole() != Role.ROLE_CITIZEN) throw new ResponseStatusException(HttpStatus.FORBIDDEN, "Only citizens can upload complaint photos"); return user; }
    private User currentUser(String email) { return userRepository.findByEmail(email).orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "User account not found")); }
    private void validateLocation(BigDecimal latitude, BigDecimal longitude, BigDecimal accuracy) { if (latitude == null || longitude == null || accuracy == null || latitude.compareTo(BigDecimal.valueOf(-90)) < 0 || latitude.compareTo(BigDecimal.valueOf(90)) > 0 || longitude.compareTo(BigDecimal.valueOf(-180)) < 0 || longitude.compareTo(BigDecimal.valueOf(180)) > 0 || accuracy.signum() < 0 || accuracy.compareTo(maxAccuracy) > 0) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Location is missing or does not meet the required accuracy"); }
    private String imageMimeType(MultipartFile photo) { try { byte[] bytes = photo.getBytes(); if (bytes.length < 12) throw new IOException(); if ((bytes[0] & 0xff) == 0xff && (bytes[1] & 0xff) == 0xd8 && (bytes[2] & 0xff) == 0xff && ImageIO.read(photo.getInputStream()) != null) return "image/jpeg"; if (bytes[0] == (byte)137 && bytes[1] == 80 && bytes[2] == 78 && bytes[3] == 71 && ImageIO.read(photo.getInputStream()) != null) return "image/png"; if (new String(bytes, 0, 4).equals("RIFF") && new String(bytes, 8, 4).equals("WEBP")) return "image/webp"; } catch (IOException ignored) { } throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Only valid JPEG, PNG, and WebP images are supported"); }
    private void authorizeView(ComplaintPhotoUpload upload, User requester) { if (requester.getUserRole() == Role.ROLE_ADMIN || upload.getUser().getUserId().equals(requester.getUserId())) return; Complaint complaint = upload.getComplaint(); if (complaint != null && complaint.getOfficer() != null && complaint.getOfficer().getUserId().equals(requester.getUserId()) && requester.getUserRole() == Role.ROLE_OFFICER) return; throw new ResponseStatusException(HttpStatus.FORBIDDEN, "You are not allowed to view this photo"); }
    private UUID idFromReference(String reference) { if (reference == null || !reference.matches("/api/complaint-photos/[0-9a-fA-F-]{36}/content")) throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid complaint photo reference"); try { return UUID.fromString(reference.substring("/api/complaint-photos/".length(), reference.length() - "/content".length())); } catch (IllegalArgumentException exception) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid complaint photo reference"); } }
    private String reference(UUID uploadId) { return "/api/complaint-photos/" + uploadId + "/content"; }
    private String extensionFor(String mime) { return switch (mime) { case "image/jpeg" -> ".jpg"; case "image/png" -> ".png"; default -> ".webp"; }; }
}
