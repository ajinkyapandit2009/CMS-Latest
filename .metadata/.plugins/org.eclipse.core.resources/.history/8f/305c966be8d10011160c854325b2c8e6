
package com.cmsbackend.services.impl;

import org.modelmapper.ModelMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.server.ResponseStatusException;

import com.cmsbackend.dtos.CaseOfficerRequestDto;
import com.cmsbackend.dtos.CaseOfficerResponseDto;
import com.cmsbackend.entities.CaseOfficer;
import com.cmsbackend.entities.User;
import com.cmsbackend.enums.Role;
import com.cmsbackend.repositories.CaseOfficerRepository;
import com.cmsbackend.repositories.UserRepository;
import com.cmsbackend.services.CaseOfficerService;

@Service
public class CaseOfficerServiceImpl implements CaseOfficerService {

    @Autowired
    private CaseOfficerRepository caseOfficerRepository;

    @Autowired
    private UserRepository userRepository;

    @Autowired
    private ModelMapper modelMapper;

    @Override
    @Transactional
    public CaseOfficerResponseDto createCaseOfficer(
            CaseOfficerRequestDto caseOfficerRequestDto) {

        // 1. Find the existing user account
        User user = userRepository
                .findById(caseOfficerRequestDto.getUserId())
                .orElseThrow(() ->
                    new ResponseStatusException(
                        HttpStatus.NOT_FOUND,
                        "User account not found"));

        // 2. Verify that the user has the Officer role
        if (user.getUserRole() != Role.ROLE_OFFICER) {
            throw new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "The user must have the ROLE_OFFICER role");
        }

        // 3. Check whether an officer profile already exists
        if (caseOfficerRepository.existsById(user.getUserId())) {
            throw new ResponseStatusException(
                    HttpStatus.CONFLICT,
                    "Case Officer profile already exists");
        }

        // 4. Normalize and check employee number
        String employeeNumber =
                caseOfficerRequestDto.getEmployeeNumber().trim();

        if (caseOfficerRepository
                .existsByEmployeeNumber(employeeNumber)) {
            throw new ResponseStatusException(
                    HttpStatus.CONFLICT,
                    "Employee number is already registered");
        }

        // 5. Convert request DTO to entity
        CaseOfficer caseOfficer = modelMapper.map(
                caseOfficerRequestDto,
                CaseOfficer.class);

        // Link the existing User account
        caseOfficer.setUser(user);
        caseOfficer.setUserId(user.getUserId());
        caseOfficer.setEmployeeNumber(employeeNumber);

        // 6. Save the Case Officer profile
        CaseOfficer savedCaseOfficer =
                caseOfficerRepository.save(caseOfficer);

        // 7. Convert saved entity to response DTO
        CaseOfficerResponseDto responseDto =
                modelMapper.map(
                        savedCaseOfficer,
                        CaseOfficerResponseDto.class);

        // Populate details from the linked User
        responseDto.setUserId(user.getUserId());
        responseDto.setFirstName(user.getFirstName());
        responseDto.setLastName(user.getLastName());
        responseDto.setEmail(user.getEmail());
        responseDto.setDepartment(savedCaseOfficer.getDepartment());
        responseDto.setDesignation(savedCaseOfficer.getDesignation());
        responseDto.setEmployeeNumber(
                savedCaseOfficer.getEmployeeNumber());

        return responseDto;
    }
}
