spring.application.name=cmsbackend
server.port=8080

# database settings

spring.datasource.url=${CMS_DB_URL:jdbc:mysql://localhost:3306/cms}
spring.datasource.username=${CMS_DB_USERNAME:root}
spring.datasource.password=${CMS_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# hibernate related setting
# =============================================================

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect


#spring.security.user.name=admin
#spring.security.user.password=admin

spring.app.jwtSecret=${CMS_JWT_SECRET}
spring.app.jwtExpirationMs=604800000

cms.photo.storage-dir=uploads/complaints
cms.photo.max-size-bytes=5242880
cms.photo.max-accuracy-meters=50
cms.location-sharing.frontend-base-url=${CMS_FRONTEND_BASE_URL:http://localhost:5173}
cms.location-sharing.expiry-minutes=5
cms.cors.allowed-origins=${CMS_ALLOWED_ORIGINS:http://localhost:5173}
